# Supabase project settings — find these in Project Settings > API.
# Safe to expose to the browser: scoped by Row Level Security.
VITE_SUPABASE_URL=https://lnrjryuaxfcdwasexgba.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_wNHC44KwgY2c3wllGiQK5Q_MvYH437y

# Server-only. Never prefix with VITE_ — that would bundle it into client JS.
# Only needed for admin/background tasks (e.g. the Heartbeat cron), not for
# normal auth or vault_items access, which goes through the anon key + RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gmail SMTP — interim sender until a real email domain is set up (same
# account used for the heartbeat-cron secrets). Needs a Gmail App Password,
# not your normal password: myaccount.google.com/apppasswords
SMTP_USER=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password
