{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Aeterna",
  "version": "0.1.0",
  "identifier": "ai.aeterna.desktop",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build && node src-tauri/build-sidecar.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Aeterna",
        "url": "http://localhost:3000",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/server"
    ],
    "resources": [
      "resources/client"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
